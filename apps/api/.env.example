# Agarha API + worker configuration. Validated with Zod at boot (src/config/env.ts): the process refuses
# to start on missing/invalid values, and production refuses test/mock settings.
# Copy to .env for local development. Never commit real keys. Outside local, values come from the
# cloud secrets manager (infra/terraform), one set per environment, sandbox keys outside production.

# --- Runtime -------------------------------------------------------------------------------------
NODE_ENV=development
# local | preview | staging | production
APP_ENV=local
PORT=4000
LOG_LEVEL=debug

# --- Data ----------------------------------------------------------------------------------------
DATABASE_URL=postgres://agarha:agarha@localhost:5432/agarha
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# --- HTTP / cookies ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# e.g. .agarha.com in staging/production (shared by web + admin subdomains)
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Reverse proxies in front of the API (Cloudflare + load balancer = 2)
TRUST_PROXY_HOPS=0
API_PUBLIC_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# --- Secrets (generate per environment: openssl rand -base64 48) --------------------------------
JWT_SECRET=local-dev-only-jwt-secret-change-me-0000000000
JWT_ISSUER=agarha-api
HASH_PEPPER=local-dev-only-hash-pepper-change-me-000000000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktdG90cC1rZXktMzJieXRlcyE=

# --- Bot protection (Cloudflare Turnstile) ------------------------------------------------------
# Test secret always passes (verified offline); production refuses it.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- OTP + SMS (two providers with failover; console = logs the code, local/test only) ----------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER_SECONDS=60
# Ordered failover list: twilio,vonage (production needs two) | console
SMS_PROVIDERS=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_WEBHOOK_URL=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Agarha
VONAGE_SIGNATURE_SECRET=

# --- WhatsApp Business Platform (OTP fallback, dealer lead alerts, nudges) ----------------------
# meta | console (records messages instead of sending)
WHATSAPP_PROVIDER=console
WHATSAPP_OTP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=agarha_otp
WHATSAPP_LEAD_TEMPLATE=agarha_lead_alert
WHATSAPP_NUDGE_TEMPLATE=agarha_availability_nudge

# --- Push + email ------------------------------------------------------------------------------
# expo | console
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
# resend | console
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Agarha <no-reply@agarha.com>

# --- Storage (S3-compatible: Cloudflare R2, AWS S3 or MinIO from infra/docker-compose.yml) -------
# s3 | local (signed local-disk mock, local/test only)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
# MinIO: STORAGE_DRIVER=s3, STORAGE_ENDPOINT=http://localhost:9000, STORAGE_FORCE_PATH_STYLE=true
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=minio
STORAGE_SECRET_ACCESS_KEY=minio-secret
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BUCKET=public-media
STORAGE_PRIVATE_BUCKET=private-docs
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/public-media

# --- Maps (geocoding; provider still open: ADR-0011) --------------------------------------------
# google | mapbox | mock
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Payments (dealer subscriptions + featured listings only; customers never pay) ---------------
# paymob | mock
PAYMENT_GATEWAY=mock
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
FEATURED_PRICE_PER_DAY_EGP=50
MOCK_PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-local-only

# --- Search engine (P6, behind the search_engine_meilisearch flag) -----------------------------
MEILI_HOST=
MEILI_API_KEY=

# --- Observability + analytics -----------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Sign-in with Google / Apple (token audiences) + admin SSO ----------------------------------
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
GOOGLE_WORKSPACE_DOMAIN=agarha.com
ADMIN_GOOGLE_CLIENT_ID=
# CIDR list for /v1/admin*; required in production
ADMIN_IP_ALLOWLIST=
# Local/test only: dev login instead of Google SSO (refused in production)
ADMIN_DEV_LOGIN=true

# --- Feature flags forced from env (PostHog decides otherwise). * = all on -----------------------
FLAGS=*
