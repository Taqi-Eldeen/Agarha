# Copy to .env for local development. Never commit real keys.
NODE_ENV=development
APP_ENV=local
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgres://agarha:agarha@localhost:5432/agarha
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
JWT_SECRET=local-dev-only-jwt-secret-change-me-0000000000
HASH_PEPPER=local-dev-only-hash-pepper-change-me-000000000
# Cloudflare Turnstile test secret: always passes. Use real keys outside local.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SMS_PROVIDERS=console
WHATSAPP_OTP_ENABLED=false
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktdG90cC1rZXktMzJieXRlcyE=
ADMIN_DEV_LOGIN=true
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
API_PUBLIC_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
# Force every feature flag on locally. In other environments PostHog decides.
FLAGS=*
