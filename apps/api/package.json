{
  "name": "@agarha/api",
  "version": "0.1.0",
  "private": true,
  "description": "Agarha HTTP API (NestJS modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register scripts/migrate.ts",
    "db:seed": "node -r @swc-node/register scripts/seed.ts",
    "openapi": "node -r @swc-node/register scripts/openapi.ts"
  },
  "dependencies": {
    "@agarha/i18n": "workspace:*",
    "@agarha/schemas": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@agarha/config": "workspace:*",
    "@agarha/test-utils": "workspace:*",
    "@nestjs/testing": "^11.1.6",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^11.7.1",
    "@testcontainers/redis": "^11.7.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.10",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3"
  }
}
