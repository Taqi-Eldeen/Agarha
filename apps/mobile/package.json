{
  "name": "@agarha/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Agarha customer app (Expo, iOS + Android). Search, listing, contact, saved, account.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
