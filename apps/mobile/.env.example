# Copy to apps/mobile/.env for local development. EAS builds set these per profile in eas.json
# (public values) and as EAS secrets (build-time secrets such as the maps key and Sentry token).

# --- Runtime (inlined into the JS bundle; never put secrets here) ---
EXPO_PUBLIC_APP_ENV=development
# Android emulator: http://10.0.2.2:4000. Physical device: your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Host used for shared links and universal/app links.
EXPO_PUBLIC_WEB_HOST=agarha.com
# Cloudflare Turnstile test site key (always passes). Real key per environment.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
# Google sign-in OAuth client ids (Google Cloud console). Empty hides the Google button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# true opens the on-device Storybook route (development builds only).
EXPO_PUBLIC_STORYBOOK_ENABLED=false

# --- Build time (app.config.ts; read by EAS / expo prebuild, not shipped to JS) ---
APP_ENV=development
EXPO_OWNER=
EAS_PROJECT_ID=
# Android Maps SDK key (react-native-maps). iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=
# Source-map upload. Leave SENTRY_ORG empty to skip the Sentry plugin entirely.
SENTRY_ORG=
SENTRY_PROJECT=agarha-mobile
SENTRY_AUTH_TOKEN=
