{
  "extends": "@agarha/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["jest", "nativewind/types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "app.config.ts", "nativewind-env.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts", "jest.setup.ts"]
}
