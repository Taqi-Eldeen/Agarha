NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side fetches (inside the cluster this is the internal service URL).
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# local | preview | staging | production. Only "production" is indexable (robots.txt) and it tags Sentry events.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_MEDIA_URL=http://localhost:4000
# Cloudflare Turnstile test site key (always passes). Real key per environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# MapLibre style URL for the chosen maps provider (open decision: Google vs Mapbox).
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# P2: the dealer PWA ships first with the public site hidden. Set to "on" at public launch (P3).
NEXT_PUBLIC_PUBLIC_SITE=on

# Mobile deep links (served at /.well-known/*). Empty = no app association.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.agarha.app
ANDROID_PACKAGE=com.agarha.app
# Comma-separated SHA-256 fingerprints of the Play App Signing key (Play Console → App integrity).
ANDROID_SHA256_CERT_FINGERPRINTS=
