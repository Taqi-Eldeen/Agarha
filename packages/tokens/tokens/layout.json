{
  "space": {
    "$type": "dimension",
    "0": { "$value": 0 },
    "1": { "$value": 4 },
    "2": { "$value": 8 },
    "3": { "$value": 12 },
    "4": { "$value": 16 },
    "5": { "$value": 20 },
    "6": { "$value": 24 },
    "8": { "$value": 32 },
    "10": { "$value": 40 },
    "12": { "$value": 48 },
    "16": { "$value": 64 }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": 6 },
    "md": { "$value": 10, "$description": "Inputs, buttons" },
    "lg": { "$value": 16, "$description": "Cards" },
    "full": { "$value": 9999, "$description": "Chips" }
  },
  "elevation": {
    "$type": "shadow",
    "0": { "$value": "none", "$description": "Flat" },
    "1": {
      "$value": "0 1px 3px rgba(22,32,43,0.08), 0 1px 2px rgba(22,32,43,0.06)",
      "$description": "Card hover"
    },
    "2": { "$value": "0 8px 24px rgba(22,32,43,0.12)", "$description": "Sheet / popover" },
    "3": { "$value": "0 16px 48px rgba(22,32,43,0.20)", "$description": "Modal" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": 120 },
      "base": { "$value": 200 },
      "slow": { "$value": 320 }
    },
    "easing": { "$type": "cubicBezier", "out": { "$value": [0, 0, 0.2, 1] } }
  },
  "z": {
    "$type": "number",
    "sticky": { "$value": 10 },
    "header": { "$value": 20 },
    "sheet": { "$value": 30 },
    "modal": { "$value": 40 },
    "toast": { "$value": 50 }
  },
  "breakpoint": {
    "$type": "dimension",
    "md": { "$value": 640 },
    "lg": { "$value": 1024 },
    "xl": { "$value": 1280 }
  },
  "icon": {
    "stroke": { "$type": "number", "$value": 1.75 }
  }
}
