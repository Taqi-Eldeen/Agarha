{
  "name": "@agarha/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed API client generated from docs/api/openapi.json + TanStack Query hooks (web and mobile)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.json -o src/openapi.d.ts",
    "build": "pnpm generate && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agarha/schemas": "workspace:*",
    "openapi-fetch": "^0.14.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@agarha/config": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "@types/react": "^19.1.13",
    "eslint": "^9.37.0",
    "openapi-typescript": "^7.9.1",
    "react": "19.1.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "sideEffects": false
}
