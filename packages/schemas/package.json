{
  "name": "@agarha/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas and enums (client + server validation)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@agarha/config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
