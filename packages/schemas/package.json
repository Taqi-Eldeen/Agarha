{
  "name": "@agarha/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas and enums (client + server validation)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./enums": {
      "import": {
        "types": "./dist/enums.d.ts",
        "default": "./dist/enums.js"
      },
      "require": {
        "types": "./dist/enums.d.cts",
        "default": "./dist/enums.cjs"
      }
    },
    "./phone": {
      "import": {
        "types": "./dist/phone.d.ts",
        "default": "./dist/phone.js"
      },
      "require": {
        "types": "./dist/phone.d.cts",
        "default": "./dist/phone.cjs"
      }
    },
    "./arabic": {
      "import": {
        "types": "./dist/arabic.d.ts",
        "default": "./dist/arabic.js"
      },
      "require": {
        "types": "./dist/arabic.d.cts",
        "default": "./dist/arabic.cjs"
      }
    },
    "./freshness": {
      "import": {
        "types": "./dist/freshness.d.ts",
        "default": "./dist/freshness.js"
      },
      "require": {
        "types": "./dist/freshness.d.cts",
        "default": "./dist/freshness.cjs"
      }
    },
    "./price": {
      "import": {
        "types": "./dist/price.d.ts",
        "default": "./dist/price.js"
      },
      "require": {
        "types": "./dist/price.d.cts",
        "default": "./dist/price.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@agarha/config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "sideEffects": false
}
