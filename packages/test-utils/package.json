{
  "name": "@agarha/test-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./msw": {
      "import": {
        "types": "./dist/msw.d.ts",
        "default": "./dist/msw.js"
      },
      "require": {
        "types": "./dist/msw.d.cts",
        "default": "./dist/msw.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@agarha/schemas": "workspace:*",
    "msw": "^2.11.0"
  },
  "devDependencies": {
    "@agarha/config": "workspace:*",
    "eslint": "^9.37.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
